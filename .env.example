# انسخ هذا الملف إلى .env محلياً، أو أضف نفس المفاتيح في إعدادات
# Environment على Render. لا تضع قيماً حقيقية هنا أو ترفعه لـ git.

# مفتاح تشفير الجلسات — إجباري. التطبيق يرفض الإقلاع بدونه.
# ولّد واحداً بـ: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# مفتاح Groq API — من https://console.groq.com
GROQ_API_KEY=

# رابط اتصال Postgres (مثال: من Supabase أو Render Postgres)
DATABASE_URL=

# رابط Redis لتحديد المعدل المشترك بين workers (مثال: Upstash Redis)
# اختياري تقنياً، لكن موصى به بشدة في الإنتاج — بدونه يعمل التحديد
# بالذاكرة فقط وغير موثوق مع أكثر من gunicorn worker.
REDIS_URL=

# Supabase Storage — تخزين دائم للصور (المرفوعة للتحليل والمولّدة
# بالذكاء الاصطناعي). اختياري تماماً: بدونهما التطبيق يعمل بالسلوك
# القديم (اسم الملف فقط للصور المرفوعة، رابط pollinations.ai مباشرة
# للمولّدة). لازم تُنشئ يدوياً من لوحة Supabase قبل التشغيل:
#   - باكت خاص (Private) اسمه "chat-uploads"
#   - باكت عام (Public) اسمه "chat-generated"
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# لوحة التحكم (اختياري) — قائمة بريد إلكتروني مفصولة بفاصلة، فقط هذه
# الحسابات تقدر تفتح /admin. فارغ = لا أحد يدخل (آمن افتراضياً).
ADMIN_EMAILS=

# اختياري — غيّرها لـ false فقط لو تختبر محلياً عبر http://localhost
# بدون HTTPS (كوكي الجلسة بعلامة Secure ما تُرسل على اتصال HTTP عادي).
# على Render (HTTPS دائماً) اتركها فاضية — الافتراضي true آمن.
SESSION_COOKIE_SECURE=

# ─── الصوت (STT/TTS) ────────────────────────────────────────────
# لا يحتاج متغير بيئة جديد — يستخدم GROQ_API_KEY نفسه. لكن ⚠️ التحويل
# نص→صوت (TTS) يتطلب خطوة يدوية إجبارية: افتح console.groq.com بنفس
# الحساب → Playground → Text to Speech → اقبل شروط موديلَي Orpheus
# (العربي والإنجليزي). بدون هذي الخطوة، كل طلب TTS يفشل بخطأ صلاحيات
# حتى لو الكود سليم 100%. تحويل صوت→نص (STT عبر Whisper) لا يحتاج
# هذي الخطوة ويعمل مباشرة بمفتاح API العادي.
