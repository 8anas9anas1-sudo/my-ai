# انسخ هذا الملف إلى .env واملأ القيم قبل التشغيل محلياً:
#   cp .env.example .env
# على Render نفسه، اضبط هذي القيم مباشرة بـ Environment Variables
# بلوحة التحكم — لا حاجة لملف .env هناك إطلاقاً (wsgi.py يستدعي
# load_dotenv() بأمان في الحالتين، وما يكتب فوق قيمة مضبوطة فعلياً).

# ─── إجباري — التطبيق يرفض الإقلاع بدونها ──────────────
FLASK_SECRET_KEY=
GROQ_API_KEY=
DATABASE_URL=

# ─── موصى به بشدة ───────────────────────────────────────
# رابط Upstash Redis (أو أي Redis آخر) — بدونه، تحديد المعدل
# (rate limiting) يعمل بالذاكرة المحلية فقط: يُعاد تصفيره مع كل
# إعادة تشغيل، ولا يُشارَك بين عدة عمليات gunicorn لو أكثر من worker.
REDIS_URL=

# ─── اختياري: لوحة التحكم /admin ────────────────────────
# بريد إلكتروني واحد أو أكثر مفصولة بفاصلة. فارغة = لا أحد يدخل
# (هذا السلوك الآمن الافتراضي، وليس خطأً).
ADMIN_EMAILS=

# ─── اختياري: تخزين دائم للصور المرفوعة (Supabase Storage) ─
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── اختياري: الذاكرة العائلية الدائمة (RAG) ────────────
# اكتب True بالضبط لتفعيلها — تحتاج pgvector بقاعدة البيانات ورام
# إضافي (sentence-transformers يجلب معه torch/transformers).
ENABLE_RAG=False

# ─── اختياري: كوكيز الجلسة بدون HTTPS محلياً ────────────
# اتركه true دائماً بالإنتاج. اكتب false فقط للتطوير المحلي عبر
# http://localhost بدون شهادة HTTPS.
SESSION_COOKIE_SECURE=true

# ─── اختياري: يخص فقط حسابات قديمة سابقة لترقية bcrypt ──
# اتركه فارغاً لو تأكدت عدم وجود حسابات SHA-256 قديمة (راجع التحذير
# اللي يطبعه التطبيق بسجلات الإقلاع لو هذا فارغاً، وتعليق مطوَّل
# بـ app/security.py: legacy_sha256_hash).
PASSWORD_SALT=
